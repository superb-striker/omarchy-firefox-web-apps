#!/bin/bash
set -euo pipefail
browser=$(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null || true)
if [[ -z $browser ]]; then
  browser=$(xdg-mime query default x-scheme-handler/https 2>/dev/null || true)
fi
case ${browser,,} in
  firefox* | *firefox*.desktop)
    if (($# != 1)); then
      echo 'Usage: omarchy-launch-webapp HTTP_OR_HTTPS_URL' >&2
      exit 2
    fi
    exec "${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-firefox-web-apps/bridge.py" --open "$1"
    ;;
  *) exec /usr/share/omarchy/bin/omarchy-launch-webapp "$@" ;;
esac
