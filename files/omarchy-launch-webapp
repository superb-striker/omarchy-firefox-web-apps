#!/bin/bash
set -euo pipefail
if command -v omarchy-cmd-default-browser >/dev/null 2>&1; then
  browser=$(omarchy-cmd-default-browser 2>/dev/null || true)
else
  browser=$(env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings get default-web-browser 2>/dev/null || true)
fi
if [[ -z $browser ]]; then
  browser=$(XDG_CURRENT_DESKTOP= xdg-mime query default x-scheme-handler/https 2>/dev/null || true)
fi
case ${browser,,} in
  firefox* | *firefox*.desktop)
    if (($# != 1)); then
      echo 'Usage: omarchy-launch-webapp HTTP_OR_HTTPS_URL' >&2
      exit 2
    fi
    exec "${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-firefox-web-apps/bridge.py" --open "$1"
    ;;
  *) exec /usr/share/omarchy/bin/omarchy-launch-webapp "$@" ;;
esac
