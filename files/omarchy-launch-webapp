#!/bin/bash

# Launch Omarchy web apps as native Firefox Taskbar Tabs when Firefox is the
# default browser. Keep Omarchy's original behavior for every other browser.

if (($# == 0)); then
  echo "Usage: omarchy-launch-webapp URL [browser arguments...]" >&2
  exit 2
fi

browser=$(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null)
if [[ -z $browser ]]; then
  browser=$(xdg-mime query default x-scheme-handler/https 2>/dev/null)
fi

case $browser in
firefox* | *firefox*.desktop)
  for command in jq setsid uwsm-app; do
    if ! command -v "$command" >/dev/null 2>&1; then
      echo "Required command not found: $command" >&2
      exit 1
    fi
  done

  browser_exec=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' \
    "$HOME/.local/share/applications/$browser" \
    "$HOME/.nix-profile/share/applications/$browser" \
    "/usr/share/applications/$browser" 2>/dev/null | head -1)

  if [[ -z $browser_exec ]]; then
    echo "Could not resolve the default browser executable from $browser" >&2
    exit 1
  fi

  firefox_root="${XDG_CONFIG_HOME:-$HOME/.config}/mozilla/firefox"
  profile_relative=$(sed -n 's/^Default=//p' "$firefox_root/installs.ini" 2>/dev/null | head -1)
  profile="$firefox_root/$profile_relative"

  if [[ -z $profile_relative || ! -d $profile ]]; then
    echo "Could not resolve the active Firefox profile" >&2
    exit 1
  fi

  # Firefox assigns the permanent ID when it first registers the site. Reuse
  # it later and supply a valid provisional UUID for the first launch.
  host=${1#*://}
  host=${host%%/*}
  host=${host%%:*}
  registry="$profile/taskbartabs/taskbartabs.json"
  taskbar_id=$(jq -r --arg host "$host" \
    '.taskbarTabs[]? | select(any(.scopes[]?; .hostname == $host)) | .id' \
    "$registry" 2>/dev/null | head -1)

  if [[ -z $taskbar_id ]]; then
    hash=$(printf '%s' "$1" | sha256sum | cut -c1-32)
    taskbar_id="${hash:0:8}-${hash:8:4}-${hash:12:4}-${hash:16:4}-${hash:20:12}"
  fi

  exec setsid uwsm-app -- "$browser_exec" \
    -taskbar-tab "$taskbar_id" -new-window "$1" \
    -profile "$profile" -container 0 "${@:2}"
  ;;
*)
  exec /usr/share/omarchy/bin/omarchy-launch-webapp "$@"
  ;;
esac
